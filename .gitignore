# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller output. Nothing builds an exe any more -- the spec, the release
# workflow and requirements-build.txt were dropped on 2026-09-06 once every
# version became playable in a browser. These stay ignored so an ad-hoc
# pyinstaller run cannot dirty the tree.
#
# Note the 2023 exe remains in git history (it was added in the initial commit),
# so untracking it does not shrink an existing clone -- only a history rewrite
# would, and that is not worth doing.
build/
dist/

# JetBrains
.idea/

# Node (v2, training)
node_modules/

# Generated training corpus. Not committed -- 20k samples is a few hundred MB
# of PNG, and generate_corpus.mjs rebuilds it from a fixed seed anyway.
training/corpus/
# Resolution experiments generate corpus<N>/ alongside it.
training/corpus[0-9]*/
training/corpus_v2geom/

# Generated structure corpus. 20MB and 1.5s to rebuild, so not worth committing.
# The [0-9]* variant catches per-board corpora written by --nodes/--out, which
# the bare trailing slash lets through.
training/graph_corpus/
training/graph_corpus[0-9]*/

# Checkpoints and logs. The models that ship are committed as .tflite/.json;
# the runs they came out of are not.
training/runs/
training/runs_gnn/
training/runs_detector/

# Intermediate for verify_export.mjs; regenerated by verify_export.py.
training/expected.json

# Colab training intermediates from the v2 era. These were exported per
# training run and are never referenced by the game -- only the .tflite is, and
# that one is tracked as truss_game_v2_model.tflite. The trailing slashes keep
# the ignore to the directories, since the two no longer share a stem.
truss_game_AI_model/
retrained_*/
predict.npy
test_model.tflite

# Debug screenshots dumped by __predict during model-orientation testing
test*.png

# Salvaged v2-era artefacts and the TensorFlow environment that was used to
# read them. Nothing in here is tracked any more: the scores these produced
# were measured with the training set inside the evaluation, so they were not
# worth keeping. The one model that counts is truss_game_v2_model.tflite at the
# repository root, re-measured on unseen trusses.
training/recovered/
training/tfvenv/

# Personal Claude Code overrides (not for the team, since there is no team).
.claude/settings.local.json

# Scratch notes for generating the article illustrations. These were an aid to
# thinking up images, not part of the project, and were committed by mistake in
# 2c119f3; untracked again 2026-09-06. The file stays on disk.
images/illustration-prompts.md
