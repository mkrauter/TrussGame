# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller output. Neither directory is tracked any more -- the Windows
# binary is published as a GitHub Releases asset by .github/workflows/release.yml
# instead of being committed. truss_game_AI.spec lives at the repo root and IS
# tracked; it is the build recipe, not build output.
#
# Note the 2023 exe remains in git history (it was added in the initial commit),
# so untracking it does not shrink an existing clone -- only a history rewrite
# would, and that is not worth doing.
build/
dist/

# JetBrains
.idea/

# Node (v2, training)
node_modules/

# Generated training corpus. Reproducible from generate_corpus.mjs at a fixed
# seed, and published as a release asset rather than committed -- 20k samples
# is a few hundred MB of PNG.
training/corpus/

# Colab training intermediates. These are exported per training run and are
# never referenced by the game -- only the .tflite is.
# Note the trailing slash on truss_game_AI_model/: it matches the SavedModel
# directory, NOT the deployed truss_game_AI_model.tflite, which stays tracked.
truss_game_AI_model/
retrained_*/
predict.npy
test_model.tflite

# Debug screenshots dumped by __predict during model-orientation testing
test*.png
