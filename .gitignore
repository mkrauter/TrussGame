# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# PyInstaller output. Nothing builds an exe any more -- the spec, the release
# workflow and requirements-build.txt were dropped on 2026-09-06 once every
# version became playable in a browser. These stay ignored so an ad-hoc
# pyinstaller run cannot dirty the tree.
#
# Note the 2023 exe remains in git history (it was added in the initial commit),
# so untracking it does not shrink an existing clone -- only a history rewrite
# would, and that is not worth doing.
build/
dist/

# JetBrains
.idea/

# Node (v2, training)
node_modules/

# Generated training corpus. Reproducible from generate_corpus.mjs at a fixed
# seed, and published as a release asset rather than committed -- 20k samples
# is a few hundred MB of PNG.
training/corpus/
# Resolution experiments generate corpus<N>/ alongside it.
training/corpus[0-9]*/
training/corpus_v2geom/

# Generated structure corpus. 20MB and 1.5s to rebuild, so not worth committing.
# The [0-9]* variant catches per-board corpora written by --nodes/--out, which
# the bare trailing slash lets through.
training/graph_corpus/
training/graph_corpus[0-9]*/

# Checkpoints and logs. The model that ships gets published as a release asset.
training/runs/
training/runs_gnn/
training/runs_detector/

# Intermediate for verify_export.mjs; regenerated by verify_export.py.
training/expected.json

# Colab training intermediates. These are exported per training run and are
# never referenced by the game -- only the .tflite is.
# truss_game_AI_model/ is the 2023 SavedModel directory and keeps its original
# name -- it is a historic artifact, and training/diagnose_savedmodels.py and
# eval_savedmodels.py look it up by that name alongside retrained_200/250. The
# deployed model was renamed to truss_game_v2_model.tflite and stays tracked;
# the two no longer share a stem, so the trailing slash is belt-and-braces.
truss_game_AI_model/
retrained_*/
predict.npy
test_model.tflite

# Debug screenshots dumped by __predict during model-orientation testing
test*.png

# Recovered 2023 artefacts and the TensorFlow environment used to read
# them. Both are large and reproducible: the models came out of the
# Recycle Bin, the venv from one pip install.
# Contents, not the directory: git cannot re-include a file whose parent
# directory is excluded, so the negation below would be silently ignored.
training/recovered/*
# ...except the model itself. It was recovered from the Recycle Bin and is
# the only surviving artefact of the 2023 attempts; the SavedModel it came
# from is 4MB of TensorFlow 2.9 that nothing here can read any more.
!training/recovered/retrained_250.tflite
training/tfvenv/

# Personal Claude Code overrides (not for the team, since there is no team).
.claude/settings.local.json
